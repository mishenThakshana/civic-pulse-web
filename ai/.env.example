# Civi Pulse AI - example configuration. Copy to .env and adjust.
# This file contains NO secrets. Never commit .env.

APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Models ----------------------------------------------------------------
# Leave empty until trained models exist; the API starts anyway and reports
# "model_not_loaded" for the affected components.
#
# TEXT_MODEL_NAME / SEVERITY_MODEL_NAME: local directory (preferred) or Hugging
#   Face id of a FINE-TUNED sequence-classification model, e.g. models/text_category
# EMBEDDING_MODEL_NAME: Sentence Transformers model, e.g.
#   sentence-transformers/LaBSE  (covers English, Sinhala and Tamil)
# IMAGE_MODEL_PATH: trained YOLO weights, e.g. models/image/civi_pulse_cls_v1.pt
# SPAM_MODEL_PATH: trained scikit-learn pipeline, e.g. models/spam/spam_model.joblib
TEXT_MODEL_NAME=
SEVERITY_MODEL_NAME=
EMBEDDING_MODEL_NAME=
IMAGE_MODEL_PATH=
SPAM_MODEL_PATH=

# GEMINI_API_KEY: enables the multimodal screening model (photo + description in
#   one pass), the main model. The trained models above are its fallback when the key is empty or a call fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# false = never download models at startup (Hugging Face local_files_only=True).
ALLOW_MODEL_DOWNLOAD=false
# auto | cpu | cuda | mps  (auto falls back to CPU; no GPU required)
DEVICE=auto
# Use documented rule-based development fallbacks when models are missing.
# Their results are always labelled status="heuristic".
ENABLE_HEURISTIC_FALLBACKS=true

# --- Thresholds ----------------------------------------------------------------
SPAM_THRESHOLD=0.70
CONSISTENCY_THRESHOLD=0.70
DUPLICATE_THRESHOLD=0.80
VALIDITY_REVIEW_THRESHOLD=0.50

# --- Duplicate detection ---------------------------------------------------------
DUPLICATE_RADIUS_METERS=150
DUPLICATE_TIME_WINDOW_HOURS=168
MAX_DUPLICATE_CANDIDATES=50

# --- Input limits ----------------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_DIMENSION=64
MAX_DESCRIPTION_LENGTH=5000

# --- Expected service area (Sri Lanka). Outside = spam signal only, never rejected.
SERVICE_AREA_MIN_LAT=5.85
SERVICE_AREA_MAX_LAT=9.90
SERVICE_AREA_MIN_LON=79.50
SERVICE_AREA_MAX_LON=81.95

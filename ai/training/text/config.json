{
  "_comment": "Multilingual (en/si/ta) text classifiers. base_model is fine-tuned; verify Sinhala/Tamil coverage before choosing.",
  "dataset_dir": "datasets/processed/text",
  "base_model": "xlm-roberta-base",
  "max_length": 256,
  "epochs": 5,
  "learning_rate": 2e-5,
  "batch_size": 16,
  "weight_decay": 0.01,
  "seed": 42,
  "min_rows": {"train": 2100, "val": 450, "test": 450},
  "tasks": {
    "category": {"label_column": "category", "output_dir": "models/text_category", "env_var": "TEXT_MODEL_NAME"},
    "severity": {"label_column": "severity", "output_dir": "models/severity", "env_var": "SEVERITY_MODEL_NAME"}
  }
}

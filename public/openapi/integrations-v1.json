{
  "openapi": "3.0.3",
  "info": {
    "title": "CivicPulse Department Integration API",
    "version": "1.0.0",
    "description": "Lets a municipal department's own systems (work-order, asset or ticketing systems, dashboards) read the citizen reports CivicPulse has assigned to that department and post status updates back to the citizen. Every request is authenticated with a department API key issued by a CivicPulse administrator. Human-readable guide: /developers"
  },
  "servers": [
    {
      "url": "/api/integrations/v1",
      "description": "This CivicPulse instance"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Department"
    },
    {
      "name": "Reports"
    },
    {
      "name": "Reference data"
    }
  ],
  "paths": {
    "/department": {
      "get": {
        "tags": [
          "Department"
        ],
        "operationId": "getDepartment",
        "summary": "Check the connection and see who this key belongs to",
        "responses": {
          "200": {
            "description": "The department, its workload and the key's permissions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Department"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": [
          "Reference data"
        ],
        "operationId": "listCategories",
        "summary": "List report categories",
        "responses": {
          "200": {
            "description": "All categories, alphabetically.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/reports": {
      "get": {
        "tags": [
          "Reports"
        ],
        "operationId": "listReports",
        "summary": "List reports assigned to your department",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "resolved"
              ]
            },
            "description": "Only reports with this status."
          },
          {
            "name": "category_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Only reports in this category."
          },
          {
            "name": "updated_since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only reports changed at or after this moment (ISO 8601, any offset). Use for incremental sync; results may repeat the boundary report, so upsert by id."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "-created_at",
                "created_at",
                "-updated_at",
                "updated_at",
                "-votes_count"
              ],
              "default": "-created_at"
            },
            "description": "Sort field; a leading '-' means descending."
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of reports. Status history is not included in list results; fetch a single report for it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportPage"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/reports/{reportId}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "operationId": "getReport",
        "summary": "Get one report with its full status history",
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "description": "The report's ID (its CivicPulse reference number).",
            "schema": {
              "type": "integer",
              "example": 1042
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The report.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Report"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/reports/{reportId}/updates": {
      "post": {
        "tags": [
          "Reports"
        ],
        "operationId": "createReportUpdate",
        "summary": "Post a status update (notifies the citizen)",
        "description": "Records a status update on the report's public timeline and sends the citizen a push notification. Requires a key with 'Read & update' access. Send JSON, or multipart/form-data when attaching a photo.",
        "parameters": [
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "description": "The report's ID (its CivicPulse reference number).",
            "schema": {
              "type": "integer",
              "example": 1042
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportUpdateInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ReportUpdateInput"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "photo": {
                        "type": "string",
                        "format": "binary",
                        "description": "Optional progress photo (image, max 6 MB)."
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The update was recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "update": {
                          "$ref": "#/components/schemas/StatusUpdate"
                        },
                        "report": {
                          "$ref": "#/components/schemas/Report"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The key is read-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "cpk_\u2026",
        "description": "Send your department API key as 'Authorization: Bearer cpk_\u2026'."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "The API key is missing, malformed or has been revoked.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The report does not exist or is not assigned to your department.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "More than 120 requests in a minute with this key. Wait for the number of seconds in the Retry-After header.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "The request was invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "resolved"
        ],
        "description": "open = received, not yet started; in_progress = work under way; resolved = fixed."
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "Department": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "contact_email": {
            "type": "string",
            "format": "email"
          },
          "report_counts": {
            "type": "object",
            "properties": {
              "open": {
                "type": "integer"
              },
              "in_progress": {
                "type": "integer"
              },
              "resolved": {
                "type": "integer"
              }
            }
          },
          "api_key": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "prefix": {
                "type": "string",
                "example": "cpk_a1B2c3D4"
              },
              "can_update_reports": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "StatusUpdate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "from_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Status"
              }
            ],
            "nullable": true
          },
          "to_status": {
            "$ref": "#/components/schemas/Status"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "photo_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "changed_by": {
            "type": "string",
            "description": "Panel user's name, or '<Department> (via API)'."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Report": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "status_label": {
            "type": "string",
            "example": "In Progress"
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ],
            "nullable": true
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "address": {
                "type": "string",
                "nullable": true
              },
              "map_url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "reporter": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "contact_phone": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "photo_url": {
            "type": "string",
            "format": "uri"
          },
          "votes_count": {
            "type": "integer",
            "description": "How many citizens say this affects them."
          },
          "status_history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusUpdate"
            },
            "description": "Newest first. Only returned by GET /reports/{reportId}."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReportUpdateInput": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "description": "Shown to the citizen and anyone following the report."
          }
        }
      },
      "ReportPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Report"
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string",
                "nullable": true
              },
              "last": {
                "type": "string",
                "nullable": true
              },
              "prev": {
                "type": "string",
                "nullable": true
              },
              "next": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "last_page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "from": {
                "type": "integer",
                "nullable": true
              },
              "to": {
                "type": "integer",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
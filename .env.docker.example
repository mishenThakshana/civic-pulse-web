APP_NAME=CivicPulse
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://civicpulse.ribluma.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DB_HOST is overridden to "db" by docker-compose.yml regardless of the value here.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=civic_pulse
DB_USERNAME=civic_pulse
DB_PASSWORD=
# Only used to initialize the mysql container (docker-compose.yml); not read by Laravel.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Push notifications (Firebase Admin SDK). Place the downloaded service-account
# JSON inside the storage-data volume (e.g. storage/app/firebase-service-account.json)
# and point this at its in-container path.
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-service-account.json

# Used by docker-compose.yml to pick which image tag to pull; the deploy
# workflow does not need to set this since it always publishes :latest.
IMAGE_TAG=latest

# Reference only — this file is NOT used by Docker. It goes on the VPS itself,
# in the *host* nginx (the one already serving your other sites), as a new
# server block alongside them. It reverse-proxies the public domain to the
# container nginx, which docker-compose binds to 127.0.0.1:8081 only.
#
# Install:
#   sudo cp this file to /etc/nginx/sites-available/civicpulse.ribluma.com
#   sudo ln -s /etc/nginx/sites-available/civicpulse.ribluma.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d civicpulse.ribluma.com

server {
    listen 80;
    server_name civicpulse.ribluma.com;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20M;
    }
}
